{
  "name": "outputguard",
  "version": "1.0.0",
  "description": "Validate, repair, and retry LLM structured outputs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "outputguard": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "json",
    "json-schema",
    "validation",
    "repair",
    "structured-output",
    "openai",
    "anthropic",
    "ai",
    "json-repair",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndcorder/outputguard-js.git"
  },
  "homepage": "https://github.com/ndcorder/outputguard-js#readme",
  "bugs": {
    "url": "https://github.com/ndcorder/outputguard-js/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
